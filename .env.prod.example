# Produção: cp .env.prod.example .env  (na VPS, ao lado do docker-compose.prod.yml)
# Gere cada secret com: openssl rand -hex 24

POSTGRES_DB=stringtracker
POSTGRES_USER=stringtracker
POSTGRES_PASSWORD=

OIDC_CLIENT_SECRET=

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

MINIO_ROOT_USER=padelmatch
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_AVATARS=

# --- Agenda de professores (obrigatórias: sem elas o deploy para antes de trocar a API) ---
# Chave AES-256 que cifra os tokens OAuth dos clubes: openssl rand -base64 32
# Não troque depois de clubes conectados: os tokens guardados deixam de abrir e os clubes precisam reconectar.
TOKEN_CIPHER_KEY=
# Mercado Pago, aplicação de produção (Suas integrações → Credenciais de produção).
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Mesma URL cadastrada em "URLs de redirecionamento" da aplicação.
MP_REDIRECT_URI=https://clube.padel.kameziro.com.br/pagamentos/retorno
# Assina o state do OAuth, 32 caracteres ou mais: openssl rand -hex 24
MP_STATE_KEY=
# Chave secreta gerada em Webhooks → Configurar notificações (eventos de pedido, "order"), com a URL
# https://padel.kameziro.com.br/api/payments/mercadopago/webhook
MP_WEBHOOK_SECRET=
# Nunca defina MP_SANDBOX_PAYER_FIRST_NAME aqui (só dev: aprova Pix de teste).

# --- E-mail dos convites (opcional; sem SMTP o painel mostra o link para cópia) ---
MAIL_FROM=no-reply@padel.kameziro.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=padelmatch-avatars
