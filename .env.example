# Copie para .env e ajuste:  cp .env.example .env
# Quarkus carrega .env automaticamente no quarkus:dev
# docker compose também lê este arquivo para Postgres/Keycloak

# --- HTTP ---
QUARKUS_HTTP_PORT=8080

# --- PostgreSQL (API + container) ---
POSTGRES_DB=stringtracker
POSTGRES_USER=stringtracker
POSTGRES_PASSWORD=change-me
POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/stringtracker

# --- Keycloak / OIDC (Quarkus service client) ---
OIDC_AUTH_SERVER_URL=http://localhost:8180/realms/stringtracker
OIDC_CLIENT_ID=stringtracker-api
OIDC_CLIENT_SECRET=change-me-api-secret
OIDC_TOKEN_ISSUER=http://localhost:8180/realms/stringtracker

# Client usado pelo BFF POST /api/auth/login (password grant)
AUTH_KEYCLOAK_CLIENT_ID=stringtracker-expo

# --- Keycloak admin (docker compose --profile full + cadastro BFF) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8180

# --- MinIO (fotos de perfil / object storage S3-compatível) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET_AVATARS=padelmatch-avatars
# Endpoint para a API Quarkus (host → container na rede docker use http://minio:9000)
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
# URL pública base dos objetos (mobile / browser)
MINIO_PUBLIC_BASE_URL=http://localhost:9000
